# Apodex API Configuration
# Required: get a key at https://platform.apodex.ai (API Keys page)
APODEX_API_KEY=

# Optional: Apodex API base URL (OpenAI-compatible)
APODEX_BASE_URL=https://api.apodex.ai/v1

# Optional: model to use. apodex-1-0-deep-solve fits RCA/judgment tasks best.
# Other options: apodex-1-0-deep-research (fast fact-finding), apodex-1-0-deep-discover (Responses API only)
APODEX_MODEL=apodex-1-0-deep-solve
